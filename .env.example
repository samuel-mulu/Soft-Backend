# Neon (pooler): sslmode=require, connect_timeout=30, pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pgbouncer=true"

# Render sets PORT automatically. Local dev uses 4000.
PORT=4000

JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"

# Comma-separated browser origins (no trailing slash). Local + production:
# CORS_ORIGIN="http://localhost:3000,https://your-app.vercel.app"
CORS_ORIGIN="http://localhost:3000"

# When true, allows any https://*.vercel.app (production + preview deploys)
CORS_ALLOW_VERCEL="true"

SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="ChangeMe123!"
